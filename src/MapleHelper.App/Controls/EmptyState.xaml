<UserControl x:Class="MapleHelper.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MapleHelper.App.Controls"
             x:Name="Root">
    <StackPanel HorizontalAlignment="Center" Margin="0,32">
        <controls:AnimatedSprite Sprite="{Binding Sprite, ElementName=Root}" Scale="1.5" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,12,0,0" />
        <TextBlock Text="{Binding Text, ElementName=Root}" Style="{StaticResource Text.Hint}" FontSize="13"
                   TextAlignment="Center" MaxWidth="380" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
