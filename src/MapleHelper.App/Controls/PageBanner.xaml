<UserControl x:Class="MapleHelper.App.Controls.PageBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MapleHelper.App.Controls"
             x:Name="Root" Height="150">
    <Border CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True" Background="{StaticResource Brush.Sky}">
        <Grid>
            <!-- Mây -->
            <Ellipse Width="180" Height="60" Fill="White" Opacity="0.35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="260,18,0,0" />
            <Ellipse Width="120" Height="40" Fill="White" Opacity="0.3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="360,40,0,0" />

            <!-- Nhân vật Maple đứng trên nền gạch -->
            <Image Source="/Assets/Images/banner-characters.png" Height="120" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,-40,-6" />

            <StackPanel VerticalAlignment="Top" Margin="24,20,0,0">
                <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="34" FontWeight="Black" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#1B5E9E" BlurRadius="0" ShadowDepth="3" Direction="270" Opacity="0.8" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding Subtitle, ElementName=Root}" FontSize="14" FontWeight="SemiBold" Foreground="#FFF4D6" Margin="2,2,0,0" />
            </StackPanel>

            <!-- Ốc sên bò dọc chân banner -->
            <Canvas VerticalAlignment="Bottom" Height="34" ClipToBounds="True" IsHitTestVisible="False">
                <controls:AnimatedSprite x:Name="Walker" Sprite="mobs/snail" Flip="True" FrameInterval="0:0:0.16" Canvas.Bottom="2" Canvas.Left="0">
                    <controls:AnimatedSprite.RenderTransform>
                        <TranslateTransform x:Name="WalkerTransform" />
                    </controls:AnimatedSprite.RenderTransform>
                </controls:AnimatedSprite>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
