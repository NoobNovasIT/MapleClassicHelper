<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>MapleClassicHelper</AssemblyName>
    <RootNamespace>MapleHelper.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Main tự viết trong Program.cs (Velopack + single instance chạy trước WPF) -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>MapleHelper.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MapleHelper.Core\MapleHelper.Core.csproj" />
    <ProjectReference Include="..\MapleHelper.Infrastructure\MapleHelper.Infrastructure.csproj" />
    <ProjectReference Include="..\MapleHelper.Native\MapleHelper.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
