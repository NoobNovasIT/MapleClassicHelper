<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Background" Color="#F7F5F0" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F1EEE7" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E3DED3" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C9C2B4" />

    <SolidColorBrush x:Key="Brush.Text" Color="#2B2A27" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6B6860" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#9A968C" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#E8781E" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#CF6814" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FDEBDA" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#8A4210" />

    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E6F2E1" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#2F5E1C" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBE7E6" />
    <SolidColorBrush x:Key="Brush.DangerText" Color="#8F2420" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#E6EFF9" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#1F4A7A" />

    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
</ResourceDictionary>
