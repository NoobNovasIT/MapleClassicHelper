<Window x:Class="MapleHelper.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:MapleHelper.App.Shell"
        xmlns:placeholder="clr-namespace:MapleHelper.App.Features.Placeholder"
        xmlns:settings="clr-namespace:MapleHelper.App.Features.Settings"
        Title="Maple Classic Helper"
        Width="1000" Height="680" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type placeholder:PlaceholderViewModel}">
            <placeholder:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,20">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Brush.AccentSoft}">
                        <TextBlock Text="M" FontWeight="Bold" Foreground="{StaticResource Brush.AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Maple Classic Helper" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding StartOverlayCommand}" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="White" />
                            <TextBlock Text="Overlay mode" Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Hotkey: Ctrl + Shift + M" Style="{StaticResource Text.Hint}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15"
                                           Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="10,0,0,0"
                                           Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Nội dung trang -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding SelectedNav.Page}" />
        </ScrollViewer>
    </Grid>
</Window>
