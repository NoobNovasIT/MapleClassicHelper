<Window x:Class="MapleHelper.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:MapleHelper.App.Shell"
        xmlns:controls="clr-namespace:MapleHelper.App.Controls"
        xmlns:news="clr-namespace:MapleHelper.App.Features.News"
        xmlns:saved="clr-namespace:MapleHelper.App.Features.Saved"
        xmlns:history="clr-namespace:MapleHelper.App.Features.History"
        xmlns:settings="clr-namespace:MapleHelper.App.Features.Settings"
        Title="Maple Classic Helper"
        Icon="/Assets/Icons/app.ico"
        Width="1100" Height="740" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type news:NewsViewModel}">
            <news:NewsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type saved:SavedViewModel}">
            <saved:SavedView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type history:HistoryViewModel}">
            <history:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,14">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <controls:AnimatedSprite Sprite="mobs/orange-mushroom" Scale="0.7" FrameInterval="0:0:0.2" VerticalAlignment="Bottom" />
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Maple Classic" FontWeight="Black" FontSize="16" Foreground="{StaticResource Brush.AccentText}" />
                            <TextBlock Text="Helper cho người Việt" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Nút vào overlay: cây nấm cam đứng trên nút -->
                <StackPanel DockPanel.Dock="Bottom">
                    <controls:AnimatedSprite Sprite="mobs/ribbon-pig" Scale="0.8" HorizontalAlignment="Right" Margin="0,0,14,-6" Panel.ZIndex="1" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding StartOverlayCommand}" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="White" />
                            <TextBlock Text="{Binding OverlayButtonText}" Margin="8,0,0,0" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding OverlayHotkeyText}" Style="{StaticResource Text.Hint}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:NavItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15"
                                           Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="10,0,0,0" FontWeight="SemiBold"
                                           Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Nội dung trang -->
        <ContentControl Grid.Column="1" Content="{Binding SelectedNav.Page}" />
    </Grid>
</Window>
