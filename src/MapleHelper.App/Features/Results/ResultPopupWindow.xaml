<Window x:Class="MapleHelper.App.Features.Results.ResultPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MapleHelper.App.Features.Results"
        xmlns:controls="clr-namespace:MapleHelper.App.Controls"
        xmlns:ai="clr-namespace:MapleHelper.Core.Ai;assembly=MapleHelper.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:ResultPopupViewModel}"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI">

    <Border Style="{StaticResource Popup.Card}">
        <DockPanel Margin="14,10,14,12">
            <!-- Tiêu đề, kéo để di chuyển -->
            <Grid DockPanel.Dock="Top" MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <controls:AnimatedSprite Sprite="{Binding Sprite}" Scale="0.7" VerticalAlignment="Bottom" />
                    <Image Source="{Binding Icon}" Width="30" Height="30" Margin="6,0,0,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Brush.AccentText}"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding ToggleSaveCommand}" Style="{StaticResource Button.Icon}" ToolTip="Lưu / bỏ lưu">
                        <TextBlock FontFamily="{StaticResource Font.Icons}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE734;" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                            <Setter Property="Text" Value="&#xE735;" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Content="&#xE8C8;" Command="{Binding CopyCommand}" Style="{StaticResource Button.Icon}" ToolTip="Copy" />
                    <Button Content="&#xE711;" Style="{StaticResource Button.Icon}" Click="OnCloseClick" ToolTip="Đóng" />
                </StackPanel>
            </Grid>

            <!-- Tên đọc được, sửa rồi Enter để tra lại -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding CanRequery, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="13" KeyDown="OnQueryKeyDown"
                         ToolTip="Sửa tên nếu đọc sai rồi bấm Tra lại" />
                <Button Grid.Column="1" Content="Tra lại" Command="{Binding RequeryCommand}" Margin="6,0,0,0" Padding="10,5" />
            </Grid>

            <!-- Nguồn tham khảo -->
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Sources}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ai:AiSource}">
                        <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Url}" ToolTip="{Binding Url}" Padding="8,3" Margin="0,0,6,6" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;" Style="{StaticResource Text.Icon}" FontSize="10" />
                                <TextBlock Text="{Binding Title}" Margin="5,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding ExternalLinks}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ExternalLink}">
                        <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Url}" Padding="10,4" Margin="0,0,6,0" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" FontSize="11" />
                                <TextBlock Text="{Binding Label}" Margin="6,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Đang chờ AI -->
                    <StackPanel Orientation="Horizontal" Margin="0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <controls:AnimatedSprite Sprite="mobs/slime" Scale="0.6" FrameInterval="0:0:0.12" />
                        <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>

                    <Border Background="{StaticResource Brush.DangerSoft}" CornerRadius="8" Padding="10,8" Margin="0,4"
                            Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource Brush.DangerText}" />
                    </Border>

                    <controls:MarkdownViewer Markdown="{Binding Body}" Visibility="{Binding Body, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Chữ gốc -->
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding SourceText, Converter={StaticResource NullToCollapsed}}">
                        <Button Content="Xem chữ gốc tiếng Anh" Style="{StaticResource Button.Link}" Command="{Binding ToggleSourceCommand}" HorizontalAlignment="Left" />
                        <TextBox Text="{Binding SourceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,0"
                                 FontFamily="Consolas, Segoe UI" FontSize="12" Background="{StaticResource Brush.SurfaceAlt}" BorderThickness="0"
                                 Visibility="{Binding IsSourceVisible, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
