<Window x:Class="MapleHelper.App.Features.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MapleHelper.App.Controls"
        Title="Maple Classic Helper Overlay"
        Width="280" Height="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI">

    <Canvas x:Name="Root">
        <!-- 4 nút phụ: đặt chồng lên tâm nút chính, animation đẩy ra theo hình cung -->
        <Button x:Name="Sub1" Style="{StaticResource Overlay.SubButton}" Click="OnSubButtonClick" Tag="QuickTranslate"
                Opacity="0" IsHitTestVisible="False">
            <TextBlock Text="&#xE8C1;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="{StaticResource Brush.AccentText}" />
        </Button>
        <Button x:Name="Sub2" Style="{StaticResource Overlay.SubButton}" Click="OnSubButtonClick" Tag="ItemLookup"
                Opacity="0" IsHitTestVisible="False">
            <Image Source="/Assets/Icons/Items/orange-mushroom-cap.png" Width="28" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Button>
        <Button x:Name="Sub3" Style="{StaticResource Overlay.SubButton}" Click="OnSubButtonClick" Tag="QuestGuide"
                Opacity="0" IsHitTestVisible="False">
            <TextBlock Text="&#xE7C1;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="{StaticResource Brush.AccentText}" />
        </Button>
        <Button x:Name="Sub4" Style="{StaticResource Overlay.SubButton}" Click="OnSubButtonClick" Tag="ChatTranslate"
                Opacity="0" IsHitTestVisible="False">
            <TextBlock Text="&#xE8BD;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="{StaticResource Brush.AccentText}" />
        </Button>

        <!-- Nút chính: nấm cam. Bấm để bung menu, kéo để di chuyển, chuột phải để mở menu -->
        <Grid x:Name="MainButton" Width="76" Height="76" Cursor="Hand"
              MouseLeftButtonDown="OnMainMouseDown" MouseMove="OnMainMouseMove" MouseLeftButtonUp="OnMainMouseUp">
            <Ellipse x:Name="MainCircle" Fill="#FFF3D6" Stroke="{StaticResource Brush.Accent}" StrokeThickness="3">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" />
                </Ellipse.Effect>
            </Ellipse>
            <controls:AnimatedSprite Sprite="mobs/orange-mushroom" Scale="0.85" FrameInterval="0:0:0.22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" IsHitTestVisible="False" />
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Mở cửa sổ chính" Click="OnOpenMainWindow" />
                    <MenuItem Header="Ẩn overlay" Click="OnHideOverlay" />
                    <Separator />
                    <MenuItem Header="Thoát Maple Classic Helper" Click="OnExit" />
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Canvas>
</Window>
