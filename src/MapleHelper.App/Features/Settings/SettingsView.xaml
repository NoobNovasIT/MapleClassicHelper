<UserControl x:Class="MapleHelper.App.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MapleHelper.App.Features.Settings"
             xmlns:res="clr-namespace:MapleHelper.App.Resources"
             xmlns:controls="clr-namespace:MapleHelper.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <res:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <res:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20">
        <controls:PageBanner Title="Cài đặt" Subtitle="Đơn vị AI, hotkey và các tuỳ chọn chung" />

        <!-- Đơn vị AI -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Đơn vị AI" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,16"
                           Text="AI dùng để dịch, đọc ảnh chụp màn hình và tra cứu item/quest. Key được mã hoá và chỉ lưu trên máy này." />

                <TextBlock Text="Nhà cung cấp" Style="{StaticResource Text.Label}" />
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                          DisplayMemberPath="DisplayName" Width="320" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding SelectedProvider.CapabilityText}" Style="{StaticResource Text.Hint}" Margin="0,6,0,0" />

                <Grid Margin="0,16,0,4">
                    <TextBlock Text="API key" Style="{StaticResource Text.Label}" />
                    <Button Content="Lấy API key ở đâu?" Style="{StaticResource Button.Link}"
                            Command="{Binding OpenApiKeyPageCommand}" HorizontalAlignment="Right" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnPasswordChanged"
                                 Visibility="{Binding IsApiKeyVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsApiKeyVisible, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Grid.Column="1" Content="Hiện" IsChecked="{Binding IsApiKeyVisible}" Margin="12,0,0,0" />
                </Grid>

                <TextBlock Text="Model" Style="{StaticResource Text.Label}" Margin="0,16,0,4" />
                <ComboBox IsEditable="True" ItemsSource="{Binding AvailableModels}"
                          Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                          Width="320" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,6,0,0"
                           Text="Bấm Kiểm tra kết nối để tải danh sách model thật từ nhà cung cấp." />

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Kiểm tra kết nối" Command="{Binding TestConnectionCommand}" />
                    <Button Content="Lưu" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"
                            Margin="8,0,0,0" MinWidth="80" />
                </StackPanel>

                <Border x:Name="StatusBorder" CornerRadius="6" Padding="12,8" Margin="0,14,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brush.InfoSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                    <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                    <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.InfoText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.SuccessText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- Hotkey -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" DataContext="{Binding Hotkeys}">
            <StackPanel>
                <TextBlock Text="Hotkey" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,12"
                           Text="Bấm vào ô rồi nhấn tổ hợp phím mới. Backspace để xoá. Hotkey hoạt động cả khi đang ở trong game." />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HotkeyRowViewModel}">
                            <StackPanel Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                                    <controls:HotkeyBox Grid.Column="1" Modifiers="{Binding Modifiers}" VirtualKey="{Binding VirtualKey}"
                                                        IsCapturing="{Binding IsCapturing}" />
                                    <CheckBox Grid.Column="2" Content="Bật" IsChecked="{Binding Enabled}" Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.DangerText}" FontSize="11" Margin="200,2,0,0"
                                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Áp dụng hotkey" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}" />
                    <Button Content="Khôi phục mặc định" Command="{Binding ResetDefaultsCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.SuccessText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Overlay, tin tức, chung -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Tuỳ chọn" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />
                <CheckBox Content="Mở overlay ngay khi khởi động app" IsChecked="{Binding ShowOverlayOnStartup}" Margin="0,0,0,8" />
                <CheckBox IsChecked="{Binding UseAiForScreenTranslate}" Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap">
                        Nút 1 (dịch vùng chọn) dùng AI thay vì Google Dịch.
                        <Run Foreground="{StaticResource Brush.TextMuted}" Text="Chậm hơn nhưng giữ tên quái/item/NPC và đọc chữ nhỏ tốt hơn. Mặc định: OCR của Windows + Google Dịch." />
                    </TextBlock>
                </CheckBox>
                <CheckBox Content="Điểm tin: chỉ hiện tin MapleStory Classic World" IsChecked="{Binding ClassicOnly}" Margin="0,0,0,8" />
                <CheckBox Content="Điểm tin: thông báo ở khay hệ thống khi có tin mới" IsChecked="{Binding NotifyNewArticles}" Margin="0,0,0,8" />
                <CheckBox Content="Bấm X thì ẩn xuống khay hệ thống (hotkey vẫn hoạt động)" IsChecked="{Binding MinimizeToTrayOnClose}" />
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,12,0,0"
                           Text="Overlay chỉ hiện trên game khi game chạy ở chế độ cửa sổ (Options → Graphics → chọn độ phân giải không có chữ &quot;Full Screen&quot;)." />
            </StackPanel>
        </Border>

        <!-- Cập nhật -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Cập nhật" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,12"
                           Text="App tự tải bản mới từ GitHub Releases của repo bên dưới. Chỉ bản cài bằng Setup.exe mới tự cập nhật được." />
                <TextBlock Text="Repo GitHub" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding RepositoryUrl, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Tự kiểm tra khi khởi động" IsChecked="{Binding CheckUpdatesOnStartup}" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Kiểm tra cập nhật" Command="{Binding CheckUpdatesCommand}" />
                    <Button Content="Cập nhật và khởi động lại" Style="{StaticResource Button.Primary}" Command="{Binding InstallUpdateCommand}"
                            Margin="8,0,0,0" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Text.Hint}" FontSize="12.5" Margin="0,8,0,0"
                           Visibility="{Binding UpdateStatus, Converter={StaticResource NullToCollapsed}}" />
                <ProgressBar Value="{Binding UpdateProgress}" Height="6" Margin="0,8,0,0" Foreground="{StaticResource Brush.Accent}"
                             Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Giới thiệu -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:AnimatedSprite Sprite="npcs/maple-administrator" VerticalAlignment="Top" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Text.SectionTitle}">
                        <Run Text="Maple Classic Helper" />
                        <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Hint}" FontSize="12.5" Margin="0,6,0,0"
                               Text="Công cụ do cộng đồng làm cho người chơi Việt Nam. Không liên kết, không được Nexon tài trợ hay xác nhận. Hình ảnh và tên MapleStory thuộc bản quyền NEXON." />
                    <TextBlock Style="{StaticResource Text.Hint}" FontSize="12.5" Margin="0,6,0,0"
                               Text="Nguồn dữ liệu: tin tức từ nexon.com/maplestory, dữ liệu vật phẩm/quest và sprite từ maplestory.io (GMS v83)." />
                    <Button Content="Mở thư mục dữ liệu và log" Style="{StaticResource Button.Link}" Command="{Binding OpenDataFolderCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
