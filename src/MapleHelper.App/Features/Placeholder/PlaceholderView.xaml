<UserControl x:Class="MapleHelper.App.Features.Placeholder.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MapleHelper.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <controls:PageBanner Title="{Binding Title}" Subtitle="{Binding Description}" />
            <controls:EmptyState Sprite="mobs/slime" Title="Sắp có" Text="{Binding MilestoneText}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
