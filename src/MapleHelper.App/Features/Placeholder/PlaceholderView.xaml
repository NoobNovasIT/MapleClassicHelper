<UserControl x:Class="MapleHelper.App.Features.Placeholder.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28,24">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13" />
                <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Left" Margin="0,12,0,0">
                    <TextBlock Text="{Binding MilestoneText}" FontSize="12" Foreground="{StaticResource Brush.AccentText}" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
