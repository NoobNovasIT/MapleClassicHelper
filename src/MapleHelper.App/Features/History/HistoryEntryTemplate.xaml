<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MapleHelper.App.Features.History"
                    xmlns:controls="clr-namespace:MapleHelper.App.Controls"
                    xmlns:services="clr-namespace:MapleHelper.App.Services"
                    xmlns:ai="clr-namespace:MapleHelper.Core.Ai;assembly=MapleHelper.Core">

    <!-- Một mục lịch sử. Lệnh lấy từ DataContext của UserControl chứa danh sách (HistoryViewModel hoặc SavedViewModel) -->
    <DataTemplate x:Key="HistoryEntryCard" DataType="{x:Type local:HistoryItemViewModel}">
        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
            <StackPanel>
                <Grid Cursor="Hand" Background="Transparent">
                    <Grid.InputBindings>
                        <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                      Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AnimatedSprite Sprite="{Binding Sprite}" Scale="0.7" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="6,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.AccentText}" />
                            <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.Icon}" ToolTip="Lưu / bỏ lưu" CommandParameter="{Binding}"
                                Command="{Binding DataContext.ToggleSaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE734;" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                <Setter Property="Text" Value="&#xE735;" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Content="&#xE8C8;" Style="{StaticResource Button.Icon}" ToolTip="Copy kết quả" CommandParameter="{Binding}"
                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="&#xE74D;" Style="{StaticResource Button.Icon}" ToolTip="Xoá" CommandParameter="{Binding}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </Grid>

                <!-- Mở rộng: kết quả đầy đủ, ảnh vùng chụp, nguồn -->
                <StackPanel Margin="62,8,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <Border CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left" MaxHeight="220" Margin="0,0,0,10"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" />
                    </Border>
                    <controls:MarkdownViewer Markdown="{Binding Result}" />
                    <ItemsControl ItemsSource="{Binding Sources}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ai:AiSource}">
                                <TextBlock FontSize="11" Margin="0,1">
                                    <Hyperlink Command="{x:Static services:LinkCommands.Open}" CommandParameter="{Binding Url}" ToolTip="{Binding Url}">
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
