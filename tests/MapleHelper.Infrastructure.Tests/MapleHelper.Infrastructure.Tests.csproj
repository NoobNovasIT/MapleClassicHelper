    <!-- Test OCR vẽ chữ bằng WPF để tạo ảnh mẫu -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MapleHelper.Infrastructure\MapleHelper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF tắt hai implicit using này -->
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
